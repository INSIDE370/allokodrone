{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "framework": null,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "https://example-abu-sas-army.trycloudflare.com/admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://example-abu-sas-army.trycloudflare.com/admin/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://example-abu-sas-army.trycloudflare.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
